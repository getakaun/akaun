# Path to the SQLite database file
DATABASE_PATH=./data/akaun.db

# Path to the file storage root directory
STORAGE_PATH=./data/storage

# Max request body size accepted by the server (e.g. file uploads/scans).
# Must stay >= the app's own upload cap (MAX_UPLOAD_BYTES in
# src/lib/server/file-storage.ts, currently 15 MB) or uploads will be rejected
# here before the app's own size check ever runs, e.g.:
#   "Content-length of <n> exceeds limit of <BODY_SIZE_LIMIT> bytes"
# 21M rather than 15M: an MCP client attaches a file as base64 (4/3 of its
# size) inside a JSON request, so a 15 MB file needs about 20.1 MB.
BODY_SIZE_LIMIT=21M

# Log level (trace|debug|info|warn|error). Defaults to debug in dev, info in prod.
# Note: trace logs include raw statement LLM prompts and responses and may
# contain sensitive financial data. Enable trace only temporarily while debugging.
LOG_LEVEL=info

# Optional: serve over HTTPS instead of HTTP (applies to `bun run dev`/`preview`
# and the production server). Defaults to HTTP when unset.
# In dev, SSL_KEY_PATH/SSL_CERT_PATH can be left blank — a self-signed cert is
# generated automatically (browser will warn it's untrusted). The production
# server requires both paths to be set when SSL_ENABLED=true.
SSL_ENABLED=false
SSL_KEY_PATH=
SSL_CERT_PATH=

# Optional OAuth for MCP clients (ChatGPT, Codex, etc.). API tokens remain supported.
# Use your externally reachable HTTPS origin; PUBLIC_BASE_URL defaults to ORIGIN.
# HTTP is allowed only for loopback development. Issuer/resource remain on this origin.
OAUTH_ENABLED=false
# ORIGIN=https://books.example.com
# PUBLIC_BASE_URL=https://books.example.com
# AUTH_ISSUER=https://books.example.com
# MCP_RESOURCE=https://books.example.com/mcp

# MCP write tools for API-token (not OAuth) connections. Off by default, so a
# token set up for read-only use stays read-only. When true, an API token can
# use every write the token's user can do in the app. OAuth clients instead get
# writes only for the change/delete access the user ticks when connecting.
# MCP_BEARER_WRITES=false
