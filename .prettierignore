# Prettier walks the whole tree unless told otherwise, and without this file
# `bun run lint` reports thousands of files of build output and vendored code.
#
# `.gitignore` is NOT consulted by Prettier, so anything ignored there that is
# still on disk has to be repeated here.

# Dependencies and build output
node_modules/
build/
.svelte-kit/
package/
.vercel/
coverage/

# The public Docusaurus site: its own package, formatted in its own (template) style
docs/

# The database and uploaded files
data/

# Lockfiles are generated
bun.lock
package-lock.json
yarn.lock
pnpm-lock.yaml

# Generated by drizzle-kit; regenerating would undo any formatting anyway
drizzle/meta/

# Vendored/minified assets
static/opencv.js
*.min.js
*.traineddata

# Extracted archives and scratch
__MACOSX/
