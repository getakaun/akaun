{
  "name": "akaun-web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite dev",
    "build": "bun --bun vite build",
    "preview": "bun --bun vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "test:unit": "bun --bun vitest",
    "test:client": "vitest --run --project client",
    "test": "bun run test:unit -- --run --project server && bun run test:client",
    "test:mcp": "bun test --preload ./scripts/mcp-test-preload.ts src/lib/server/mcp/mcp.spec.ts src/lib/server/mcp/mcp-write.spec.ts src/lib/server/application/records.spec.ts src/lib/server/queries/settlements.spec.ts src/lib/server/queries/accounts.spec.ts src/lib/server/services/ledger.spec.ts src/lib/server/services/settlements.spec.ts src/lib/server/import/providers/shared.spec.ts",
    "test:chart": "bun run test:unit -- --run --project server src/lib/server/ledger/account-type.spec.ts src/lib/server/ledger/account-code.spec.ts src/lib/server/ledger/account-eligibility.spec.ts src/lib/server/services/accounts.spec.ts src/lib/server/services/account-defaults.spec.ts src/lib/server/services/account-migration.spec.ts src/lib/server/db/auto-upgrade.spec.ts",
    "db:generate": "drizzle-kit generate",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "desktop:dmg": "bash scripts/build-desktop-dmg.sh",
    "admin:create": "bun run scripts/create-admin.ts",
    "icons:maskable": "bun run scripts/gen-maskable-icon.ts",
    "test:oauth": "bun test --preload ./scripts/mcp-test-preload.ts src/lib/server/oauth/oauth.spec.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@internationalized/date": "^3.12.0",
    "@lucide/svelte": "^1.18.0",
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/adapter-node": "^5.5.4",
    "@sveltejs/kit": "^2.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.3.0",
    "@tauri-apps/cli": "^2.11.4",
    "@types/basic-auth": "1.1.8",
    "@types/bun": "^1.3.11",
    "@types/node": "^24",
    "@types/pdfkit": "^0.17.6",
    "@types/pngjs": "^6.0.5",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitest/browser-playwright": "^4.1.8",
    "bits-ui": "^2.16.3",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.19.0",
    "globals": "^17.6.0",
    "mode-watcher": "^1.1.0",
    "playwright": "^1.60.0",
    "prettier": "^3.8.3",
    "prettier-plugin-svelte": "^4.1.0",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "svelte": "^5.56.1",
    "svelte-check": "^4.6.0",
    "svelte-sonner": "^1.1.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^8.0.16",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.8",
    "vitest-browser-svelte": "^2.1.1"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.1",
    "@ai-sdk/groq": "^4.0.0",
    "@ai-sdk/openai": "^4.0.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "@node-oauth/oauth2-server": "5.3.0",
    "@thisux/sveltednd": "^0.4.1",
    "ai": "^7.0.3",
    "argon2": "^0.44.0",
    "basic-auth": "2.0.1",
    "chart.js": "^4.5.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "jspdf": "^4.2.1",
    "lexorank": "^1.0.5",
    "pdfkit": "^0.19.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "pngjs": "^7.0.0",
    "tailwind-merge": "^3.6.0",
    "tesseract.js": "^7.0.0",
    "unpdf": "^1.6.2",
    "zod": "^4.4.3"
  }
}
